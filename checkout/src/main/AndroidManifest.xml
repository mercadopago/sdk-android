<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true">
        <activity
            android:name="com.mercadopago.sdk.android.checkout.presentation.CheckoutActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/MercadoPago.Checkout"
            android:windowSoftInputMode="adjustResize"/>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.mercadopago.checkout.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/mp_checkout_file_paths"/>
        </provider>
    </application>
</manifest>
